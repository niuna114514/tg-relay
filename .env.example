# 复制为 .env 后填写真实值。.env 不要提交到任何仓库。
# 获取地址：https://my.telegram.org/apps  ->  API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# 会话文件路径（保存在 data/ 下，等价于账号密码，切勿外传）
TG_SESSION=data/relay.session

# 可选：已有 StringSession 时直接填这里，填了就忽略 TG_SESSION 文件
# TG_SESSION_STRING=

# 转发用账号是否已开通 Premium（1/true 表示已开通）
# Premium 用户可转发"禁止转发"的频道内容，且配额更高。
TG_PREMIUM=false

# ---------------------------------------------------------------
# 代理：Telethon 不读系统代理，必须在这里显式配置。
# 本机 Clash Verge / Mihomo 的默认混合端口就是 7897。
# 不想走代理就把下面整段注释掉。
# ---------------------------------------------------------------
TG_PROXY_TYPE=http
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=7897
# 代理要认证时才填（本地 Clash 一般不需要）
# TG_PROXY_USER=
# TG_PROXY_PASS=

# 也可以只写一行 url 代替上面四个：
# TG_PROXY=socks5://127.0.0.1:7897
