# 让编辑器统一基本格式，避免无意义的 diff
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown 里行尾两个空格是有意义的（换行），别让编辑器吃掉
trim_trailing_whitespace = false

[*.{yml,yaml,json,html,css,js}]
indent_size = 2

[*.sh]
indent_size = 4
# shell 脚本必须是 LF：带 CRLF 的话 shebang 会变成 `bash\r` 直接跑不起来
end_of_line = lf

[Makefile]
indent_style = tab

[*.{session,db,sqlite,png,jpg,gif,webp}]
insert_final_newline = false
